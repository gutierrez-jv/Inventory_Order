@model IEnumerable<Inventory_Order.Models.Database.CustomerTb>
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Customers</h1>
    <a class="btn btn-wisteria" asp-action="Create">Add customer</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle searchable-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-search-row data-name="@item.FirstName @item.LastName" data-status="@(item.IsActive ? "Active" : "Inactive")">
                        <td>@item.CustomerId</td>
                        <td>@item.FirstName</td>
                        <td>@item.LastName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.CustomerId">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
