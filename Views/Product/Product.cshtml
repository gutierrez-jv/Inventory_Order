@{
    ViewData["Title"] = "Products";
}

<h1 class="page-title">Add product</h1>

<form class="panel" method="post" action="#">
    <div class="grid-2">
        <div>
            <label>Name*</label>
            <input class="form-control" type="text" placeholder="Product name" />
        </div>
        <div>
            <label>Item code*</label>
            <input class="form-control" type="text" placeholder="Barcode or code" />
        </div>
        <div>
            <label>Description</label>
            <textarea class="form-control" rows="4" placeholder="Add short description"></textarea>
        </div>
        <div>
            <label>Stock size*</label>
            <input class="form-control" type="number" min="0" placeholder="0" />
            <label class="mt-3">Type*</label>
            <input class="form-control" type="text" placeholder="Category/type" />
        </div>
        <div>
            <label>Price*</label>
            <input class="form-control" type="number" min="0" step="0.01" placeholder="0.00" />
        </div>
        <div>
            <label>Product photos*</label>
            <input class="form-control" type="file" />
        </div>
    </div>
    <div class="text-center mt-4">
        <button type="submit" class="btn btn-wisteria">Save product</button>
    </div>
</form>