@model Inventory_Order.Models.Database.ProductTb
@{
    ViewData["Title"] = "Add Product"; // Sets the browser/page title
}

<h1 class="page-title">Add product</h1> <!-- Page heading -->

<form class="panel" asp-action="Create" method="post">
    @Html.AntiForgeryToken() <!-- Protects the form from CSRF -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div> <!-- Displays model-level validation errors -->

    <div class="grid-2">
        <div>
            <label asp-for="Name"></label> <!-- Label for the product name -->
            <input asp-for="Name" class="form-control" /> <!-- Input for entering the product name -->
            <span asp-validation-for="Name" class="text-danger"></span> <!-- Displays validation error for product name -->
        </div>
        <div>
            <label asp-for="Barcode"></label> <!-- Label for the barcode -->
            <input asp-for="Barcode" class="form-control" /> <!-- Input for entering the barcode -->
            <span asp-validation-for="Barcode" class="text-danger"></span> <!-- Displays validation error for barcode -->
        </div>
        <div>
            <label asp-for="Type"></label> <!-- Label for the product category/type -->
            <input asp-for="Type" class="form-control" /> <!-- Input for entering the product type -->
            <span asp-validation-for="Type" class="text-danger"></span> <!-- Displays validation error for product type -->
        </div>
        <div>
            <label asp-for="Quantity"></label> <!-- Label for the stock quantity -->
            <input asp-for="Quantity" class="form-control" min="0" /> <!-- Input for entering the stock quantity -->
            <span asp-validation-for="Quantity" class="text-danger"></span> <!-- Displays validation error for quantity -->
        </div>
        <div>
            <label asp-for="Price"></label> <!-- Label for the product price -->
            <input asp-for="Price" class="form-control" min="0" step="0.01" /> <!-- Input for entering the price -->
            <span asp-validation-for="Price" class="text-danger"></span> <!-- Displays validation error for price -->
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save product</button> <!-- Submits the form and saves the product -->
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a> <!-- Returns to the product list without saving -->
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /> <!-- Loads client-side validation scripts -->
}