@model IEnumerable<Inventory_Order.Models.Database.ProductTb>
@{
    ViewData["Title"] = "Products"; // Sets the browser/page title
    var isAdmin = User.IsInRole("Admin"); // Checks if the logged-in user has admin access
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Products</h1> <!-- Page heading -->
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">Add product</a> <!-- Opens the add-product page for admins -->
    }
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle searchable-table"> <!-- Displays the list of products -->
            <thead>
                <tr>
                    @if (isAdmin)
                    {
                        <th>Product Id</th> <!-- Shows the product ID column only for admins -->
                    }
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Stock Quantity</th>
                    <th>Price per Item</th>
                    <th>Barcode</th>
                    @if (isAdmin)
                    {
                        <th class="text-end">Actions</th> <!-- Shows action buttons only for admins -->
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr data-search-row data-name="@item.Name" data-category="@item.Type" data-barcode="@item.Barcode">
                        @if (isAdmin)
                        {
                            <td>@item.ProductsId</td> <!-- Displays the product ID -->
                        }
                        <td>@item.Name</td> <!-- Displays the product name -->
                        <td>@item.Type</td> <!-- Displays the product category/type -->
                        <td>@item.Quantity</td> <!-- Displays the available stock quantity -->
                        <td>₱@item.Price.ToString("N2")</td> <!-- Formats and displays the product price -->
                        <td>@item.Barcode</td> <!-- Displays the product barcode -->
                        @if (isAdmin)
                        {
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.ProductsId">Edit</a> <!-- Opens the edit-product page -->
                                <form asp-action="Delete" asp-route-id="@item.ProductsId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken() <!-- Protects the delete form from CSRF -->
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button> <!-- Deletes the selected product -->
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>