@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventor.io</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory_Order.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var isAdmin = User?.IsInRole("Admin") ?? false;
        var isCustomer = User?.IsInRole("Customer") ?? false;
        var initials = User?.Identity?.Name?.Substring(0, 1).ToUpperInvariant() ?? "?";
    }

    @if (isAuthenticated)
    {
        <div class="app-bg">
            <div class="app-shell">
                <aside class="side-nav">
                    <div class="brand">Inventor.<span>io</span></div>

                    <nav class="menu-links">
                        <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active-link" : "")" asp-controller="Home" asp-action="Index">Home</a>

                        @if (isAdmin)
                        {
                            <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active-link" : "")" asp-controller="Product" asp-action="Index">Products</a>
                            <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" ? "active-link" : "")" asp-controller="Customer" asp-action="Index">Customers</a>
                            <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active-link" : "")" asp-controller="Order" asp-action="Index">Orders</a>
                            <a class="menu-link cta-link" asp-controller="Product" asp-action="Create">+ Add product</a>
                        }
                        else if (isCustomer)
                        {
                            <a class="menu-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active-link" : "")" asp-controller="Order" asp-action="MyOrders">My orders</a>
                            <a class="menu-link cta-link" asp-controller="Order" asp-action="Create">+ Create order</a>
                        }
                    </nav>

                    <div class="mt-auto">
                        <a class="menu-link" asp-controller="Account" asp-action="Logout">Log out</a>
                    </div>
                </aside>

                <section class="content-area">
                    <header class="top-bar">
                        <input class="search-box" type="search" placeholder="Search" />
                        <div class="top-icons">
                            <span class="icon-dot"></span>
                            <span class="icon-dot"></span>
                            <span class="avatar">@initials</span>
                        </div>
                    </header>

                    <main role="main" class="page-content">
                        @RenderBody()
                    </main>
                </section>
            </div>
        </div>
    }
    else
    {
        <main class="auth-shell">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
