<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory.io</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventory_Order.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var isAdmin = User?.IsInRole("Admin") ?? false;
        var isCustomer = User?.IsInRole("Customer") ?? false;
        var displayName = isAdmin ? "Admin" : User?.FindFirst("FirstName")?.Value ?? User?.Identity?.Name ?? "User";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    @if (isAuthenticated)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Inventory.io</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Customer" ? "active" : "")" asp-controller="Customer" asp-action="Index">Customers</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Order" ? "active" : "")" asp-controller="Order" asp-action="Index">Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Create">Add Product</a></li>
                        }
                        else if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @(currentController == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">Products</a></li>
                            <li class="nav-item"><a class="nav-link @(currentController == "Order" ? "active" : "")" asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="Create">Create Order</a></li>
                        }
                    </ul>

                    <form class="d-flex gap-2 me-3" role="search" onsubmit="return false;">
                        <input id="global-search" class="form-control form-control-sm" type="search" placeholder="Search table rows" aria-label="Search" />
                        <select id="global-search-field" class="form-select form-select-sm" style="min-width: 140px;">
                            <option value="all">All</option>
                            <option value="name">Name</option>
                            <option value="category">Category</option>
                            <option value="barcode">Barcode</option>
                            <option value="status">Status</option>
                        </select>
                    </form>

                    <div class="d-flex align-items-center gap-3 text-white-50">
                        <span class="small">@displayName</span>
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">Log out</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container py-4">
            @RenderBody()
        </main>
    }
    else
    {
        <main class="auth-shell container py-5">
            @RenderBody()
        </main>
    }

    <div id="swal-server-messages"
         data-success="@TempData["SuccessMessage"]"
         data-error="@TempData["ErrorMessage"]"
         data-warning="@TempData["WarningMessage"]"
         data-info="@TempData["InfoMessage"]"
         hidden></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
