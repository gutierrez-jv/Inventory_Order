@model Inventory_Order.Models.Database.OrderTb
@{
    ViewData["Title"] = "Order Details";
}

<h1 class="page-title">Order #@Model.OrdersId</h1>

<div class="panel">
    <div class="grid-2">
        <div><strong>Customer ID:</strong> @Model.CustomersId</div>
        <div><strong>Status:</strong> @Model.OrderStatus</div>
        <div><strong>Total:</strong> @Model.TotalAmount.ToString("C")</div>
        <div><strong>Created:</strong> @Model.DateCreated.ToString("yyyy-MM-dd HH:mm")</div>
    </div>

    <h5 class="mt-4">Order items</h5>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItemTbs)
                {
                    <tr>
                        <td>@item.ProductsId</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.LineTotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">Back to orders</a>
</div>
