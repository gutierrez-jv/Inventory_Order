@model Inventory_Order.ViewModels.Order.OrderFormViewModel
@{
    ViewData["Title"] = "Create Order";
}

<h2>Create Order</h2>

<div class="alert alert-warning">
    <strong>Note:</strong> Current structure supports one product per order record.
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="OrdersId" class="form-label"></label>
        <input asp-for="OrdersId" class="form-control" />
        <span asp-validation-for="OrdersId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CustomersId" class="form-label"></label>
        <select asp-for="CustomersId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- Select Customer --</option>
        </select>
        <span asp-validation-for="CustomersId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductsId" class="form-label"></label>
        <select asp-for="ProductsId" asp-items="ViewBag.Products" class="form-select">
            <option value="">-- Select Product --</option>
        </select>
        <span asp-validation-for="ProductsId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Order</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
