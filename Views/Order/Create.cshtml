@model Inventory_Order.ViewModels.Order.CreateOrderRequestViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // Sets the page title
    ViewData["Title"] = "Create Order";

    // Gets the customer dropdown items passed from the controller
    var customers = ViewBag.Customers as List<SelectListItem> ?? new List<SelectListItem>();

    // Gets the product dropdown items passed from the controller
    var products = ViewBag.Products as List<SelectListItem> ?? new List<SelectListItem>();

    // Checks if the logged-in user is an admin
    var isAdmin = User.IsInRole("Admin");

    // Ensures the form starts with at least one order item row
    if (Model.Items == null || Model.Items.Count == 0)
    {
        Model.Items = new List<Inventory_Order.ViewModels.Order.OrderItemRequestViewModel>
        {
            new Inventory_Order.ViewModels.Order.OrderItemRequestViewModel()
        };
    }
}

<h1 class="page-title">Create order</h1> <!-- Page heading -->

<form asp-action="Create" method="post" class="panel" id="order-form">
    @Html.AntiForgeryToken() <!-- Security token to prevent CSRF attacks -->
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div> <!-- Shows model-level validation errors -->

    @if (isAdmin)
    {
        <div class="mb-3">
            <label asp-for="CustomersId">Customer</label> <!-- Label for customer selection -->
            <select asp-for="CustomersId" class="form-select" asp-items="customers">
                <option value="">Select customer</option> <!-- Default empty option -->
            </select>
            <span asp-validation-for="CustomersId" class="text-danger"></span> <!-- Shows validation error -->
        </div>
    }

    <h5>Order items</h5> <!-- Section heading -->

    <div id="items-container">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <div class="grid-2 item-row mb-3" data-index="@i">
                <div>
                    <label>Product</label> <!-- Product label -->
                    <select name="Items[@i].ProductsId" class="form-select" required>
                        <option value="">Select product</option> <!-- Default empty option -->
                        @foreach (var product in products)
                        {
                            if (product.Value == Model.Items[i].ProductsId.ToString())
                            {
                                <option selected value="@product.Value">@product.Text</option> <!-- Keeps previously selected product -->
                            }
                            else
                            {
                                <option value="@product.Value">@product.Text</option> <!-- Normal product option -->
                            }
                        }
                    </select>
                </div>
                <div>
                    <label>Quantity</label> <!-- Quantity label -->
                    <input name="Items[@i].Quantity" type="number" class="form-control" min="1" value="@(Model.Items[i].Quantity == 0 ? 1 : Model.Items[i].Quantity)" required />
                    <!-- Quantity input; defaults to 1 if value is 0 -->
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" id="add-item">+ Add another product</button> <!-- Adds another item row -->
        <button type="submit" class="btn btn-primary">Submit order</button> <!-- Submits the form -->
        <a asp-action="@(isAdmin ? "Index" : "MyOrders")" class="btn btn-outline-secondary">Cancel</a> <!-- Goes back to the proper order page -->
    </div>
</form>

<template id="item-template">
    <!-- Hidden template used by JavaScript to add new order item rows -->
    <div class="grid-2 item-row mb-3" data-index="__index__">
        <div>
            <label>Product</label>
            <select name="Items[__index__].ProductsId" class="form-select" required>
                <option value="">Select product</option>
                @foreach (var product in products)
                {
                    <option value="@product.Value">@product.Text</option> <!-- Product options for new rows -->
                }
            </select>
        </div>
        <div>
            <label>Quantity</label>
            <input name="Items[__index__].Quantity" type="number" class="form-control" min="1" value="1" required />
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /> <!-- Loads client-side validation scripts -->

    <script>
        (function () {
            // Gets the container that holds all item rows
            const itemsContainer = document.getElementById('items-container');

            // Gets the add-item button
            const addBtn = document.getElementById('add-item');

            // Gets the hidden row template
            const template = document.getElementById('item-template');

            // Stop if any required element is missing
            if (!itemsContainer || !addBtn || !template) {
                return;
            }

            // Adds a new item row when the button is clicked
            addBtn.addEventListener('click', function () {
                const currentRows = itemsContainer.querySelectorAll('.item-row').length; // Counts current rows
                const html = template.innerHTML.replaceAll('__index__', currentRows); // Replaces placeholder with the correct index
                itemsContainer.insertAdjacentHTML('beforeend', html); // Appends new row
            });
        })();
    </script>
}