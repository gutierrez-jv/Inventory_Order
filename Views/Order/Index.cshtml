@model IEnumerable<Inventory_Order.Models.Database.OrderTb>
@{
    ViewData["Title"] = "Orders";
}

<h1 class="page-title">Orders</h1>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer ID</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Date Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrdersId</td>
                        <td>@order.CustomersId</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>@order.OrderStatus</td>
                        <td>@order.DateCreated.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.OrdersId">Details</a>
                            <form asp-action="Complete" asp-route-id="@order.OrdersId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Complete</button>
                            </form>
                            <form asp-action="Cancel" asp-route-id="@order.OrdersId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
