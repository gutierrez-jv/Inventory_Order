@model IEnumerable<Inventory_Order.Models.Database.OrderTb>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Orders</h1>
    <a class="btn btn-wisteria" asp-action="Create">Create order</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle searchable-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Order Status</th>
                    <th>Customer Name</th>
                    <th>Total Amount</th>
                    <th>Date Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var customerName = order.Customers != null ? $"{order.Customers.FirstName} {order.Customers.LastName}" : $"Customer #{order.CustomersId}";
                    <tr data-search-row data-name="@customerName" data-status="@order.OrderStatus">
                        <td>@order.OrdersId</td>
                        <td>@order.OrderStatus</td>
                        <td>@customerName</td>
                        <td>₱@order.TotalAmount.ToString("N2")</td>
                        <td>@order.DateCreated.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.OrdersId">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@order.OrdersId">Edit</a>
                            <form asp-action="Complete" asp-route-id="@order.OrdersId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Complete</button>
                            </form>
                            <form asp-action="Cancel" asp-route-id="@order.OrdersId" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
