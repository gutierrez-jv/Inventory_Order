@model IEnumerable<Inventory_Order.ViewModels.Order.OrderIndexItemViewModel>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Orders</h2>
    <a asp-action="Create" class="btn btn-success">Create Order</a>
</div>

<div class="alert alert-warning">
    <strong>Note:</strong> Current database design stores one product per order and does not include dedicated status/date columns.
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped table-bordered">
    <thead class="table-light">
        <tr>
            <th>Order ID</th>
            <th>Order Status</th>
            <th>Customer Name</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Total Amount</th>
            <th>Date Created</th>
            <th style="width: 350px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrdersId</td>
                <td>@item.OrderStatus</td>
                <td>@item.CustomerName</td>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.Amount</td>
                <td>@item.DateCreated</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.OrdersId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.OrdersId" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="MarkCompleted" asp-route-id="@item.OrdersId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-success">Complete</button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@item.OrdersId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Cancel this order?');">Cancel</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
