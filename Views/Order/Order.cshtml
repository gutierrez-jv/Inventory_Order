@{
    ViewData["Title"] = "Orders";
}

<h1 class="page-title">Create order</h1>

<div class="panel">
    <div class="grid-2 mb-3">
        <div>
            <label>Customer ID*</label>
            <input class="form-control" type="number" min="1" placeholder="Enter customer id" />
        </div>
        <div>
            <label>Status</label>
            <select class="form-select">
                <option>Pending</option>
                <option>Processing</option>
                <option>Completed</option>
            </select>
        </div>
    </div>

    <h5>Order items</h5>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Line Total</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input class="form-control" type="number" min="1" placeholder="1" /></td>
                    <td><input class="form-control" type="number" min="1" placeholder="1" /></td>
                    <td><input class="form-control" type="number" min="0" step="0.01" placeholder="0.00" /></td>
                    <td><input class="form-control" type="number" min="0" step="0.01" placeholder="0.00" /></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Total Amount: $0.00</h5>
        <button type="button" class="btn btn-wisteria">Submit Order</button>
    </div>
</div>