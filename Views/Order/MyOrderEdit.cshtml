@model Inventory_Order.ViewModels.Order.UpdateOrderRequestViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit My Order";
    var products = ViewBag.Products as List<SelectListItem> ?? new List<SelectListItem>();

    if (Model.Items == null || Model.Items.Count == 0)
    {
        Model.Items = new List<Inventory_Order.ViewModels.Order.OrderItemRequestViewModel>
        {
            new Inventory_Order.ViewModels.Order.OrderItemRequestViewModel()
        };
    }
}

<h1 class="page-title">Edit my order</h1>

<form asp-action="MyOrderEdit" method="post" class="panel" id="my-edit-order-form">
    @Html.AntiForgeryToken()
    <input asp-for="OrdersId" type="hidden" />
    <input asp-for="CustomersId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3" style="max-width:420px;">
        <label asp-for="OrderStatus">Order Status</label>
        <select asp-for="OrderStatus" class="form-select">
            <option value="Pending">Pending</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        <span asp-validation-for="OrderStatus" class="text-danger"></span>
    </div>

    <h5>Order items</h5>
    <div id="items-container">
        @for (var i = 0; i < Model.Items.Count; i++)
        {
            <div class="grid-2 item-row mb-3">
                <div>
                    <label>Product</label>
                    <select name="Items[@i].ProductsId" class="form-select" required>
                        @foreach (var product in products)
                        {
                            if (product.Value == Model.Items[i].ProductsId.ToString())
                            {
                                <option selected value="@product.Value">@product.Text</option>
                            }
                            else
                            {
                                <option value="@product.Value">@product.Text</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label>Quantity</label>
                    <input name="Items[@i].Quantity" type="number" class="form-control" min="1" value="@Model.Items[i].Quantity" required />
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="button" class="btn btn-outline-primary" id="add-item">+ Add product</button>
        <button type="submit" class="btn btn-wisteria">Save changes</button>
        <a asp-action="MyOrders" class="btn btn-outline-secondary">Cancel</a>
    </div>

    <small class="text-muted d-block mt-3">Last updated time is set automatically when you save.</small>
</form>

<template id="item-template">
    <div class="grid-2 item-row mb-3">
        <div>
            <label>Product</label>
            <select name="Items[__index__].ProductsId" class="form-select" required>
                @foreach (var product in products)
                {
                    <option value="@product.Value">@product.Text</option>
                }
            </select>
        </div>
        <div>
            <label>Quantity</label>
            <input name="Items[__index__].Quantity" type="number" class="form-control" min="1" value="1" required />
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const container = document.getElementById('items-container');
        const button = document.getElementById('add-item');
        const template = document.getElementById('item-template');

        if (container && button && template) {
            button.addEventListener('click', function () {
                const index = container.querySelectorAll('.item-row').length;
                const html = template.innerHTML.replaceAll('__index__', index);
                container.insertAdjacentHTML('beforeend', html);
            });
        }
    </script>
}
