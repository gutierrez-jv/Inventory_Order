@model Inventory_Order.ViewModels.Order.OrderFormViewModel
@{
    ViewData["Title"] = "Edit Order";
}

<h2>Edit Order</h2>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="OrdersId" class="form-label"></label>
        <input asp-for="OrdersId" class="form-control" readonly />
        <span asp-validation-for="OrdersId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CustomersId" class="form-label"></label>
        <select asp-for="CustomersId" asp-items="ViewBag.Customers" class="form-select"></select>
        <span asp-validation-for="CustomersId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductsId" class="form-label"></label>
        <select asp-for="ProductsId" asp-items="ViewBag.Products" class="form-select"></select>
        <span asp-validation-for="ProductsId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update Order</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
