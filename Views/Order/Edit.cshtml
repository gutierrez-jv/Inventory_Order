@model Inventory_Order.ViewModels.Order.UpdateOrderRequestViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Order";
    var customers = ViewBag.Customers as List<SelectListItem> ?? new List<SelectListItem>();
}

<h1 class="page-title">Edit order</h1>

<form asp-action="Edit" method="post" class="panel">
    @Html.AntiForgeryToken()
    <input asp-for="OrdersId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="grid-2">
        <div>
            <label asp-for="CustomersId">Customer</label>
            <select asp-for="CustomersId" class="form-select" asp-items="customers"></select>
            <span asp-validation-for="CustomersId" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="OrderStatus">Order Status</label>
            <select asp-for="OrderStatus" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
            <span asp-validation-for="OrderStatus" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="TotalAmount">Total Amount</label>
            <input asp-for="TotalAmount" class="form-control" min="0.01" step="0.01" />
            <span asp-validation-for="TotalAmount" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="DateCreated">Date Created</label>
            <input asp-for="DateCreated" class="form-control" type="datetime-local" value="@Model.DateCreated.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="DateCreated" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-wisteria">Save changes</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
