@model Inventory_Order.ViewModels.Auth.RegisterViewModel
@{
    // Sets the page title
    ViewData["Title"] = "Register";
}

<div class="auth-card" style="max-width: 560px;">
    <h1 class="auth-title">Customer registration</h1> <!-- Main heading -->
    <p class="text-muted mb-4">Create your customer account to place and track orders.</p> <!-- Short page description -->

    <form asp-action="Register" method="post">
        <!-- Sends form data to the Register POST action -->
        @Html.AntiForgeryToken() <!-- Security token to prevent CSRF attacks -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div> <!-- Shows model-level validation errors -->

        <div class="grid-2">
            <div class="mb-3">
                <label asp-for="FirstName"></label> <!-- Label for First Name -->
                <input asp-for="FirstName" class="form-control" /> <!-- First Name input -->
                <span asp-validation-for="FirstName" class="text-danger"></span> <!-- Shows validation error -->
            </div>
            <div class="mb-3">
                <label asp-for="LastName"></label> <!-- Label for Last Name -->
                <input asp-for="LastName" class="form-control" /> <!-- Last Name input -->
                <span asp-validation-for="LastName" class="text-danger"></span> <!-- Shows validation error -->
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Username"></label> <!-- Label for Username -->
            <input asp-for="Username" class="form-control" /> <!-- Username input -->
            <span asp-validation-for="Username" class="text-danger"></span> <!-- Shows validation error -->
        </div>

        <div class="grid-2">
            <div class="mb-3">
                <label asp-for="Password"></label> <!-- Label for Password -->
                <input asp-for="Password" class="form-control" /> <!-- Password input -->
                <span asp-validation-for="Password" class="text-danger"></span> <!-- Shows validation error -->
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword"></label> <!-- Label for Confirm Password -->
                <input asp-for="ConfirmPassword" class="form-control" /> <!-- Confirm Password input -->
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span> <!-- Shows validation error -->
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Register</button> <!-- Submit registration form -->
            <a class="btn btn-outline-secondary" asp-action="Login">Back to login</a> <!-- Return to login page -->
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /> <!-- Loads client-side validation scripts -->
}